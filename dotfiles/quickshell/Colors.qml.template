// Colors.qml — единая точка правды для цветовой палитры.

pragma Singleton
import QtQuick

QtObject {
    readonly property color base00: "{{base00}}"  // фон
    readonly property color base01: "{{base01}}"  // фон чуть светлее
    readonly property color base02: "{{base02}}"  // выделение/подсветка
    readonly property color base03: "{{base03}}"  // комментарии/приглушённый текст
    readonly property color base04: "{{base04}}"  // приглушённый передний план
    readonly property color base05: "{{base05}}"  // основной текст
    readonly property color base0D: "{{base0D}}"  // акцентный синий
    readonly property color base0B: "{{base0B}}"  // зелёный
    readonly property color base08: "{{base08}}"  // красный/предупреждение
}